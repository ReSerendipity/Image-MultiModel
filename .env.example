
# ================================================================================
# Image_MultiModel 环境变量配置模板
# ================================================================================
#
# 使用说明：
# 1. 复制本文件为 .env：copy .env.example .env (Windows) 或 cp .env.example .env (Mac/Linux)
# 2. 根据需要修改下方的配置项
# 3. 程序启动时会自动读取 .env 文件中的变量
#
# 注意：如果使用便携模式（默认），通常无需修改任何配置即可直接运行！
#

# ================================================================================
# 一、模型来源模式配置
# ================================================================================

# 模型来源模式：决定从哪里加载 AI 模型
# - portable: 使用项目内置模型目录（pretrained_models/），开箱即用，推荐新手
# - shared: 使用外部共享模型目录，适合多项目环境，节省空间
#
# 环境变量名：IMAGE_MODEL_MODE
# 默认值：portable
#
IMAGE_MODEL_MODE=portable

# 共享模型目录路径（仅当 IMAGE_MODEL_MODE=shared 时生效）
# 设置后，程序会从该目录加载所有模型，而不是从项目的 pretrained_models/ 目录
#
# Windows 示例：D:\AIModels 或 E:\SharedModels
# macOS 示例：/Users/username/AIModels 或 ~/AIModels
# Linux 示例：/opt/ai-models 或 /data/models
#
# 环境变量名：COMFY_MODELS_ROOT
# 默认值：空（表示必须手动设置，防止意外使用错误路径）
#
COMFY_MODELS_ROOT=

# ================================================================================
# 二、日志配置
# ================================================================================

# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: 最详细（开发调试用，生产环境会输出大量信息）
# INFO: 标准信息（推荐生产环境）
# WARNING: 仅警告和错误（简洁模式）
#
# 环境变量名：LOG_LEVEL
# 默认值：INFO
#
LOG_LEVEL=INFO

# 日志文件路径：可以是相对路径（相对于项目根目录）或绝对路径
# 相对路径示例：logs/app.log
# 绝对路径示例：C:\Logs\ImageMultiModel\app.log (Windows) 或 /var/log/image-multi-model/app.log (Linux)
#
# 环境变量名：LOG_PATH
# 默认值：logs/app.log
#
LOG_PATH=logs/app.log

# ================================================================================
# 三、Python 解释器配置（可选）
# ================================================================================

# WinPython 安装目录（如果使用 WinPython 而不是系统 Python）
# 设置为 WinPython 的根目录（包含 python\python.exe 的父目录）
#
# 示例：
# Windows: C:\WinPython64 或 D:\Dev\WinPython\WPy64-312101
#
# 环境变量名：WINPYTHON_HOME
# 默认值：空（程序会自动查找系统 Python 或同目录下的 WinPython）
#
WINPYTHON_HOME=

# ================================================================================
# 四、高级配置（普通用户通常不需要修改）
# ================================================================================

# Hugging Face 离线模式：'0' = 允许下载，'1' = 纯离线
# HF_HUB_OFFLINE=0

# Transformers 离线模式：'0' = 允许下载，'1' = 纯离线
# TRANSFORMERS_OFFLINE=0

# ModelScope 离线模式：'0' = 允许下载，'1' = 纯离线
# MODELSCOPE_OFFLINE=0

# ComfyUI 禁用更新检查：'0' = 允许检查，'1' = 禁用检查
# COMFYUI_DISABLE_UPDATE_CHECK=1

# ── Agent(LLM 大脑)配置:经 .env 注入,config.yaml 不新增段 ──
# base_url 指向 OpenAI 兼容端点(本地 llama.cpp llama-server 或云 API)
# IMAGE_MM_AGENT_LLM_BASE_URL=http://127.0.0.1:8081/v1
# IMAGE_MM_AGENT_LLM_API_KEY=not-needed
# IMAGE_MM_AGENT_LLM_MODEL=qwen3.6-35b-a3b
# IMAGE_MM_AGENT_LLM_TEMPERATURE=0.3
# IMAGE_MM_AGENT_LLM_MAX_TOKENS=1024
