# 统一 UTF-8 + LF 行尾，防止跨平台编码损坏（2026-08 乱码事故后新增）
* text=auto

# 源码与文本文件强制 UTF-8 + LF
*.py    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.svg   text eol=lf
*.xml   text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# 二进制文件不转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.mp3  binary
*.wav  binary
*.mp4  binary
*.db   binary
*.sqlite binary

# 公钥 PEM 强制 LF：防止 Windows checkout 转 CRLF 导致公钥一致性闸门误报（任务书 P0）
*.pem  text eol=lf

# Pin .gitignore to LF in the working tree (CRLF working copy creates a catch-all ignore rule)
/.gitignore text eol=lf

# 治理文件自身固定 LF：防止 Windows checkout 转 CRLF 影响规则解析（2026-09-18）
/.gitattributes text eol=lf
/.mailmap text eol=lf

# 无扩展名构建/清单文件固定 LF
Dockerfile text eol=lf
Makefile text eol=lf

# Windows 批处理必须 CRLF(cmd 解析 LF-only 脚本会产生碎片化命令错误,2026-09-30)
*.bat text eol=crlf
*.cmd text eol=crlf
